{
  "name": "upkeep",
  "version": "0.1.0",
  "private": true,
  "description": "Upkeep — uptime monitoring for public and private (SSH/OpenVPN-tunneled) endpoints",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm --filter @upkeep/api run test:e2e",
    "dev:api": "pnpm --filter @upkeep/api run dev",
    "dev:worker": "pnpm --filter @upkeep/api run dev:worker",
    "dev:web": "pnpm --filter @upkeep/web run dev",
    "db:generate": "pnpm --filter @upkeep/db run generate",
    "db:migrate": "pnpm --filter @upkeep/db run migrate",
    "db:deploy": "pnpm --filter @upkeep/db run migrate:deploy",
    "db:seed": "pnpm --filter @upkeep/db run seed",
    "format": "prettier --write .",
    "clean": "pnpm -r run clean",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2"
  },
  "lint-staged": {
    "apps/mobile/**/*.{ts,tsx}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
