{
  "name": "@upkeep/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Upkeep headless REST API + check-engine worker (one image, two entrypoints)",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "prebuild": "pnpm --filter @upkeep/core --filter @upkeep/db --filter @upkeep/api-client run build",
    "build": "tsc -p tsconfig.build.json",
    "predev": "pnpm --filter @upkeep/core --filter @upkeep/db --filter @upkeep/api-client run build",
    "dev": "tsc-watch --noClear --onFirstSuccess \"node --enable-source-maps dist/main.js\"",
    "dev:worker": "node --enable-source-maps --watch dist/worker.js",
    "start": "node --enable-source-maps dist/main.js",
    "start:worker": "node --enable-source-maps dist/worker.js",
    "pretypecheck": "pnpm --filter @upkeep/core --filter @upkeep/db --filter @upkeep/api-client run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude 'test/e2e/**'",
    "test:e2e": "vitest run test/e2e",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/platform-express": "^12.4.2",
    "@nestjs/throttler": "^6.7.1",
    "@upkeep/core": "workspace:*",
    "@upkeep/db": "workspace:*",
    "argon2": "~0.45.2",
    "bullmq": "^6.7.5",
    "cookie-parser": "~1.4.7",
    "cors": "~2.8.6",
    "express": "~5.3.0",
    "firebase-admin": "~14.5.0",
    "helmet": "~8.3.0",
    "ioredis": "^6.0.0",
    "nodemailer": "~10.5.0",
    "pino": "~10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ssh2": "~1.17.0",
    "twilio": "~6.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.4.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "~26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/ssh2": "^1.15.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsc-watch": "^7.2.1",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
