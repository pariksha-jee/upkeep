# ─── Core (required — the API refuses to boot if invalid) ────────────────────
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
DATABASE_URL=postgresql://upkeep:upkeep@localhost:5432/upkeep
REDIS_URL=redis://localhost:6379

# Secrets: >= 32 chars each. Generate: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters

# 32 bytes, base64. Generate: openssl rand -base64 32
ENCRYPTION_KEY=Y2hhbmdlLW1lLTMyLWJ5dGVzLWVuY3J5cHRpb24h

# Comma-separated allowed origins (web app + mobile scheme)
CORS_ORIGIN=http://localhost:3000

# ─── Optional feature providers (channels of that type disabled when unset) ──
# SMTP (email notifications)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Upkeep <alerts@upkeep.dev>"

# Twilio (SMS notifications)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# Firebase (push notifications) — service account JSON, single line
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=

# ─── Tunables ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
WORKER_CONCURRENCY=50
CHECK_RETENTION_DAYS=45
CREDENTIAL_FETCH_MAX_BYTES=262144
CREDENTIAL_FETCH_TIMEOUT_MS=10000
# CREDENTIAL_HOST_ALLOWLIST=
